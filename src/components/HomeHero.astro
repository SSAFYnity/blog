---
interface Props {
  postsCount: number
}

const { postsCount } = Astro.props

const archiveEntries = [
  { label: '공지', description: '공식 안내' },
  { label: '활동', description: '활동 기록' },
  { label: '아카이브', description: `${postsCount}개의 기록` },
] as const
---

<section class="archive-masthead" aria-labelledby="archive-masthead-title">
  <div class="archive-masthead__shell">
    <div class="archive-masthead__copy">
      <h1 id="archive-masthead-title">
        <span>싸피니티 블로그</span>
        <span>공식 아카이브</span>
      </h1>
      <p>공지와 활동 기록, 운영 자료를 차분히 쌓아가는 공식 블로그입니다.</p>

      <div class="archive-masthead__actions">
        <a class="archive-masthead__primary" href="#latest">
          최신 글 보기
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14m-5-5 5 5-5 5"></path>
          </svg>
        </a>
        <a class="archive-masthead__secondary" href="#reading-guide">읽기 가이드</a>
      </div>
    </div>

    <aside class="archive-masthead__index" aria-label="블로그 기록 범위">
      <strong>기록 범위</strong>
      <dl>
        {archiveEntries.map((entry) => (
          <div>
            <dt>{entry.label}</dt>
            <dd>{entry.description}</dd>
          </div>
        ))}
      </dl>
      <p>필요한 기록을 분류와 공개일 순서로 확인할 수 있습니다.</p>
    </aside>
  </div>
</section>

<style>
  .archive-masthead {
    min-height: 720px;
    padding: 156px 0 80px;
    overflow: hidden;
    background: var(--color-canvas);
    color: var(--color-text);
  }

  .archive-masthead__shell {
    display: grid;
    width: min(100% - 40px, 1180px);
    min-height: 484px;
    margin-inline: auto;
    gap: 72px;
    align-items: center;
  }

  .archive-masthead__copy {
    align-self: center;
    max-width: 700px;
  }

  .archive-masthead h1 {
    display: grid;
    margin: 0;
    font-size: clamp(3.4rem, 6.2vw, 5.6rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .archive-masthead h1 span:last-child {
    color: var(--color-primary-strong);
  }

  .archive-masthead__copy > p {
    max-width: 31rem;
    margin-top: 30px;
    color: var(--color-text-body);
    font-size: 17px;
    font-weight: 550;
    line-height: 1.75;
    word-break: keep-all;
  }

  .archive-masthead__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 38px;
  }

  .archive-masthead__primary {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 20px;
    border-radius: var(--radius-control);
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font-size: 14px;
    font-weight: 800;
    transition: background-color var(--duration-quick) var(--ease-out);
  }

  .archive-masthead__primary:hover {
    background: var(--color-primary-hover);
  }

  .archive-masthead__primary svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .archive-masthead__secondary {
    min-height: 44px;
    padding: 12px 0 8px;
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-text);
    font-size: 14px;
    font-weight: 750;
    transition:
      border-color var(--duration-quick) var(--ease-out),
      color var(--duration-quick) var(--ease-out);
  }

  .archive-masthead__secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-hover);
  }

  .archive-masthead__index {
    min-height: 420px;
    overflow: hidden;
    padding: 38px 36px 32px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card);
    background: var(--color-primary-soft);
    color: var(--color-text);
  }

  .archive-masthead__index > strong {
    display: block;
    color: var(--color-primary-strong);
    font-size: 13px;
    font-weight: 750;
  }

  .archive-masthead__index dl {
    margin: 52px 0 0;
  }

  .archive-masthead__index dl > div {
    display: grid;
    grid-template-columns: minmax(5rem, 0.65fr) minmax(0, 1fr);
    align-items: baseline;
    gap: 20px;
    padding: 22px 0;
    border-top: 1px solid var(--color-border-strong);
  }

  .archive-masthead__index dl > div:last-child {
    border-bottom: 1px solid var(--color-border-strong);
  }

  .archive-masthead__index dt {
    color: var(--color-text-muted);
    font-size: 12px;
    font-weight: 700;
  }

  .archive-masthead__index dd {
    margin: 0;
    color: var(--color-text);
    font-size: 20px;
    font-weight: 750;
    letter-spacing: -0.02em;
    text-align: right;
  }

  .archive-masthead__index > p {
    max-width: 24rem;
    margin-top: 25px;
    color: var(--color-text-body);
    font-size: 12px;
    font-weight: 550;
    line-height: 1.65;
    word-break: keep-all;
  }

  @media (min-width: 900px) {
    .archive-masthead__shell {
      grid-template-columns: minmax(0, 1.18fr) minmax(330px, 0.72fr);
    }
  }

  @media (max-width: 899px) {
    .archive-masthead {
      min-height: auto;
      padding: 132px 0 64px;
    }

    .archive-masthead__shell {
      min-height: 0;
      gap: 52px;
    }

    .archive-masthead__index {
      min-height: 0;
    }
  }

  @media (max-width: 599px) {
    .archive-masthead {
      padding: 118px 0 48px;
    }

    .archive-masthead__shell {
      width: min(100% - 32px, 1180px);
      gap: 42px;
    }

    .archive-masthead h1 {
      font-size: clamp(2.8rem, 13vw, 3.45rem);
      line-height: 1.01;
    }

    .archive-masthead__copy > p {
      margin-top: 24px;
      font-size: 15px;
      line-height: 1.7;
    }

    .archive-masthead__actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: 30px;
    }

    .archive-masthead__primary,
    .archive-masthead__secondary {
      width: 100%;
      min-height: 48px;
    }

    .archive-masthead__secondary {
      display: grid;
      place-items: center;
      padding: 0;
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-control);
    }

    .archive-masthead__index {
      padding: 30px 24px 26px;
    }

    .archive-masthead__index dl {
      margin-top: 34px;
    }

    .archive-masthead__index dl > div {
      padding: 18px 0;
    }

    .archive-masthead__index dd {
      font-size: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-masthead__primary,
    .archive-masthead__secondary {
      transition: none;
    }
  }
</style>
